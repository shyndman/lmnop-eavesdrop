[Unit]
Description=Eavesdrop active-listener desktop dictation service
PartOf=graphical-session.target
Wants=ydotoold.service eavesdrop-server.service
After=graphical-session.target ydotoold.service eavesdrop-server.service
StartLimitIntervalSec=1800
StartLimitBurst=60

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=/bin/bash -c 'set -e; ENV=$(timeout 2 cat @REPO_ROOT@/.env); set -a; eval "$ENV"; exec @UV_BIN@ run --no-sync --package active-listener active-listener'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
