[Unit]
Description=Eavesdrop local speech-to-text transcription server
After=network.target
StartLimitIntervalSec=1800
StartLimitBurst=60

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=/bin/bash -c 'set -e; if [ -e @REPO_ROOT@/.env ]; then ENV=$(timeout 2 cat @REPO_ROOT@/.env); set -a; eval "$ENV"; set +a; fi; exec @UV_BIN@ run --no-sync --package eavesdrop-server eavesdrop-server --config @CONFIG_PATH@'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
