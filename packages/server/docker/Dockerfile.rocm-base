# syntax=docker/dockerfile:1
ARG BASE_IMAGE=rocm/pytorch:rocm7.2.3_ubuntu24.04_py3.12_pytorch_release_2.9.1
FROM $BASE_IMAGE

# Experimental: keeping AMD's matching Torch/audio/vision stack does not imply
# that NeMo Parakeet has been validated on the host GPU.
ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    EAVESDROP_ACCELERATOR=rocm
ENV PATH="$VIRTUAL_ENV/bin:/opt/rocm/llvm/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates ffmpeg git libsndfile1 sox \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /bin/
# Fail early if an overridden base no longer provides the expected vendor venv.
RUN /opt/venv/bin/python -c 'import sys, torch, torchaudio, torchvision; assert sys.version_info[:2] == (3, 12); assert torch.version.hip is not None'
