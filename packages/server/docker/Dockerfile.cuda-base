# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    EAVESDROP_ACCELERATOR=cuda
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates ffmpeg git libsndfile1 \
      python3.12 python3.12-dev python3.12-venv sox \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /bin/
# Use the same environment for Torch, NeMo, and the server. Do not create a
# separate conda environment that the final image's entrypoint cannot see.
RUN uv venv --python /usr/bin/python3.12 "$VIRTUAL_ENV"
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python "$VIRTUAL_ENV/bin/python" \
      torch==2.9.1 torchaudio==2.9.1 torchvision==0.24.1 \
      --index-url https://download.pytorch.org/whl/cu128
