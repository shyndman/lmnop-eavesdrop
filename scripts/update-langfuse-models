#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12.3,<3.13"
# dependencies = [
#     "pydantic>=2,<3",
#     "python-dotenv",
# ]
# ///

from __future__ import annotations

import argparse
import json
import logging
from dataclasses import dataclass
from pathlib import Path

from dotenv import load_dotenv
from langfuse_models.api import (
    build_langfuse_headers,
    fetch_all_model_definitions,
    fetch_openrouter_connection,
    get_langfuse_base_url,
)
from langfuse_models.catalog import (
    build_custom_models,
    build_desired_model_definitions,
    fetch_provider_map,
)
from langfuse_models.sync import sync_connection, sync_model_definitions

REPO_ROOT = Path(__file__).resolve().parent.parent


@dataclass
class Arguments(argparse.Namespace):
    """Validated parser output used to authorize synchronization writes.

    :param dry_run: Whether the command must perform reads and planning only.
    """

    dry_run: bool = False


def parse_args() -> Arguments:
    """Parse the model synchronization command line.

    :return: Arguments whose dry_run flag forbids all HTTP writes.
    :raises SystemExit: For help or invalid command-line arguments.
    """
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    return parser.parse_args(namespace=Arguments())


def main() -> int:
    """Synchronize OpenRouter connection and pricing from the provider catalog.

    :return: Zero after printing the JSON plan or applied changes.
    :raises RuntimeError: If configuration or ownership prevents safe syncing.
    :raises pydantic.ValidationError: If external catalog/server data is invalid.
    :raises urllib.error.URLError: If any catalog or Langfuse request fails.
    """
    args = parse_args()
    _ = load_dotenv(REPO_ROOT / ".env", override=True)

    langfuse_base_url = get_langfuse_base_url()
    if not langfuse_base_url:
        logging.getLogger(__name__).error("Missing LANGFUSE_BASE_URL or LANGFUSE_HOST")
        raise RuntimeError("Missing LANGFUSE_BASE_URL or LANGFUSE_HOST")

    headers = build_langfuse_headers()
    provider_map = fetch_provider_map()
    custom_models = build_custom_models(provider_map)
    desired_models = build_desired_model_definitions(provider_map)
    current_connection = fetch_openrouter_connection(langfuse_base_url, headers)
    existing_models = fetch_all_model_definitions(langfuse_base_url, headers)

    connection_result = sync_connection(
        base_url=langfuse_base_url,
        headers=headers,
        custom_models=custom_models,
        current_connection=current_connection,
        apply=not args.dry_run,
    )
    model_result = sync_model_definitions(
        base_url=langfuse_base_url,
        headers=headers,
        desired_models=desired_models,
        existing_models=existing_models,
        apply=not args.dry_run,
    )

    print(
        json.dumps(
            {
                "dryRun": args.dry_run,
                "connection": connection_result,
                "modelDefinitions": model_result,
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
